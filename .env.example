# MLflow
# MLFLOW_PORT: host port where MLflow UI is exposed (compose)
# MLFLOW_TRACKING_URI: used by training container to reach MLflow
#   - Use host.docker.internal to reach the host from inside Docker (Mac/Windows)
#   - Use 172.17.0.1 on Linux if host.docker.internal is unavailable
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://host.docker.internal:5000

# Docker build/runtime selection
# USER_NAME: used in Docker image tag (genai-audio-detector-<USER_NAME>)
USER_NAME=your_name
#
# BASE_DOCKERFILE:
#   - docker/Dockerfile       -> CPU / default image
#   - docker/Dockerfile.gpu   -> GPU-ready TF 2.11 image
BASE_DOCKERFILE=docker/Dockerfile
#
# GPU_DEVICE:
#   - all     -> expose all GPUs to training container
#   - 0       -> only GPU 0
#   - 1       -> only GPU 1
#   - 0,1     -> specific multiple GPUs
GPU_DEVICE=all

# Datasets (host path mounted read-only at /datasets inside container)
# Option A (single mount):
#   - Set DATASETS_DIR to a host folder that contains:
#       /datasets/real/...
#       /datasets/fake/...
#
# Option B (separate mounts, recommended for flexibility):
#   - Set DATASETS_REAL_DIR and DATASETS_FAKE_DIR, which will be mounted to:
#       /datasets/real
#       /datasets/fake
DATASETS_DIR=/path/to/your/datasets
DATASETS_REAL_DIR=
DATASETS_FAKE_DIR=
