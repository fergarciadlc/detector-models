FROM tensorflow/tensorflow:2.11.0-gpu-jupyter

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

ENV GIT_PYTHON_REFRESH=quiet

WORKDIR /app

# Install project runtime dependencies explicitly, excluding TensorFlow
# because it is already provided by the base GPU image.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "numpy>=1.24,<2.0" \
        "protobuf>=3.20.0,<3.21.0" \
        "pyyaml>=6.0" \
        "tqdm>=4.66" \
        "librosa>=0.10" \
        "soundfile>=0.12" \
        "scikit-learn>=1.3" \
        "matplotlib>=3.7,<3.8" \
        "mlflow>=2.11"

COPY . .

CMD ["bash"]
